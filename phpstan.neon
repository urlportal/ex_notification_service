includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - database/
        - routes/
        - tests/
    level: 8
    excludePaths:
        - bootstrap/cache/*
        - storage/*
    parallel:
        maximumNumberOfProcesses: 1
        processTimeout: 300.0
    ignoreErrors:
        - identifier: staticMethod.notFound
          path: tests/
        - identifier: missingType.generics
          path: app/Models/
