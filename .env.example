APP_NAME=notification-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=notify_db
DB_USERNAME=notify_user
DB_PASSWORD=notify_user_secret_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# TTL ключей идемпотентности в Redis
IDEMPOTENCY_TTL=86400

# Максимум subscriber_ids в одном запросе POST /api/v1/notifications/bulk
BULK_MAX_SUBSCRIBERS=500

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_TLS=false

CONTAINER_EXEC_USER_ID=1000
CONTAINER_EXEC_GROUP_ID=1000

# Идентификатор сервиса для /health/live
APP_SERVICE_ID=notification-service

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Статический Bearer-токен для аутентификации приватных API-эндпоинтов.
# Сгенерировать можно командой "openssl rand -hex 32"
# Приложение не запустится, если значение не задано или пусто.
API_TOKEN=3eeffd9c4aaa3f2f967827503ad8601632d409b6acf0bca106905ebed8b262e2

# = = = Gateway Stub conf = = =
# Вероятность временной ошибки от 0.0 до 1.0. При срабатывании нужен retry.
GATEWAY_STUB_TEMP_FAILURE_RATE=0.1
# Вероятность постоянной ошибки от 0.0 до 1.0. При срабатывании retry бессмысленен.
GATEWAY_STUB_PERM_FAILURE_RATE=0.02
# Диапазон имитируемой задержки провайдера в миллисекундах
GATEWAY_STUB_MIN_LATENCY_MS=10
GATEWAY_STUB_MAX_LATENCY_MS=50

# = = = Bulk Expand Consumer = = =
# Кол-во процессов bulk-expand-consumer
BULK_EXPAND_NUMPROCS=1
# prefetch_count: bulk-expand-сообщения тяжёлые, поэтому обрабатываем по одному
BULK_EXPAND_PREFETCH=1
# Размер одного INSERT-батча (N уведомлений + N send-команд) в рамках транзакции
BULK_EXPAND_CHUNK_SIZE=100
# Приоритетный exchange
RABBITMQ_EXCHANGE=notifications.exchange
# Bulk-expand-топология
RABBITMQ_BULK_EXPAND_EXCHANGE=notifications.bulk-expand.exchange
RABBITMQ_BULK_EXPAND_QUEUE=notifications.bulk-expand
RABBITMQ_BULK_EXPAND_ROUTING_KEY=bulk-expand

# = = = Notification Sender = = =
# Число воркеров transactional-очереди (транзакционных сообщений меньше по объёму)
SENDER_TX_NUMPROCS=2
# prefetch_count для воркеров transactional
SENDER_TX_PREFETCH=10
# Число воркеров marketing-очереди (marketing даёт больше нагрузки, поэтому пул больше)
SENDER_MK_NUMPROCS=4
# prefetch_count для воркеров marketing
SENDER_MK_PREFETCH=10
# Имена приоритетных очередей (по умолчанию совпадают с definitions.json).
# При добавлении нового типа рассылок добавить новый блок ENV (RABBITMQ_QUEUE_<NAME>,
# SENDER_<NAME>_NUMPROCS, SENDER_<NAME>_PREFETCH) + запись в config/notifications.php
# + очередь и binding в deploy/dev/rabbitmq/definitions.json.
RABBITMQ_QUEUE_TRANSACTIONAL=notifications.transactional
RABBITMQ_QUEUE_MARKETING=notifications.marketing

# = = = Outbox Relay = = =
# Число параллельных relay-процессов под управлением supervisord
OUTBOX_RELAY_NUMPROCS=1
# Размер батча: сколько pending-строк обрабатывается за одну итерацию
OUTBOX_RELAY_BATCH_SIZE=50
# Пауза (мс) при пустом outbox перед следующей проверкой
OUTBOX_RELAY_IDLE_SLEEP_MS=5000

# = = = Retry конфигурация = = =
# Общее число попыток доставки (1 исходная + retry-попытки). Должно
# совпадать с (count(notifications.retry.levels) + 1), иначе приложение
# не стартует.
RETRY_MAX_ATTEMPTS=4
# TTL retry-очередей в миллисекундах. Меняется одновременно с
# deploy/dev/rabbitmq/definitions.json (числовые значения дублируются;
# приложение их в брокер не применяет, TTL знает брокер).
RETRY_30S_TTL_MS=30000
RETRY_5M_TTL_MS=300000
RETRY_30M_TTL_MS=1800000
# Имя retry-exchange. По умолчанию notifications.retry.exchange.
# RABBITMQ_RETRY_EXCHANGE=notifications.retry.exchange

# Webhook callbacks: SMSC.ru
# Список CIDR через запятую, с которых разрешены callback'и от SMSC.ru.
# Пустое значение - все запросы отклоняются (fail-closed).
PROVIDER_SMSC_CALLBACK_ALLOWED_CIDRS=

# Webhook callbacks: Mailgun
# Webhook signing key из раздела Sending -> Webhooks в админке Mailgun.
# Не путать с API key.
PROVIDER_MAILGUN_WEBHOOK_SIGNING_KEY=
# Защита от replay-атак. По умолчанию 300.
PROVIDER_MAILGUN_CALLBACK_REPLAY_WINDOW=300
