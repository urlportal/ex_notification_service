APP_NAME=notification-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=notify_db
DB_USERNAME=notify_user
DB_PASSWORD=notify_user_secret_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_TLS=false

CONTAINER_EXEC_USER_ID=1000
CONTAINER_EXEC_GROUP_ID=1000

# Идентификатор сервиса для /health/live
APP_SERVICE_ID=notification-service

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Статический Bearer-токен для аутентификации приватных API-эндпоинтов.
# Сгенерировать можно командой "openssl rand -hex 32"
# Приложение не запустится, если значение не задано или пусто.
API_TOKEN=3eeffd9c4aaa3f2f967827503ad8601632d409b6acf0bca106905ebed8b262e2

# = = = Gateway Stub conf = = =
# Вероятность временной ошибки от 0.0 до 1.0. При срабатывании нужен retry.
GATEWAY_STUB_TEMP_FAILURE_RATE=0.1
# Вероятность постоянной ошибки от 0.0 до 1.0. При срабатывании retry бессмысленен.
GATEWAY_STUB_PERM_FAILURE_RATE=0.02
# Диапазон имитируемой задержки провайдера в миллисекундах
GATEWAY_STUB_MIN_LATENCY_MS=10
GATEWAY_STUB_MAX_LATENCY_MS=50
